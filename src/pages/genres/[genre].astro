---
import Layout from '../../layouts/Layout.astro';
import { getMoviesByGenre } from '../../lib/movies';

const runtimeEnv = Astro.locals.runtime?.env;

if (!runtimeEnv?.DB) {
  throw new Error('D1 database binding DB is not configured.');
}

const genre = String(Astro.params.genre ?? '').trim();

const decodedGenre = decodeURIComponent(genre);

const movies = decodedGenre
  ? await getMoviesByGenre(runtimeEnv.DB, decodedGenre)
  : [];
---

<Layout
  title={`${decodedGenre || 'Genre'} Movies — REBELVAULT`}
  description={`Explore ${decodedGenre || 'genre'} movies inside REBELVAULT.`}
>

  <section class="section page-section">

    <div class="section-header">

      <div>

        <a
          href="/genres"
          class="section-link"
        >
          ← All genres
        </a>

        <div
          class="eyebrow"
          style="margin-top:24px;"
        >
          REBELVAULT GENRE
        </div>

        <h1 class="section-title">
          {decodedGenre}
        </h1>

      </div>

      <span class="movie-count">
        {movies.length}
        {movies.length === 1 ? ' movie' : ' movies'}
      </span>

    </div>

    {
      movies.length > 0 ? (
        <div class="movie-grid">

          {movies.map((movie, index) => (
            <a
              href={`/movie/${movie.id}`}
              class="movie-card"
            >

              <div class="poster">

                <img
                  src={movie.poster}
                  alt={movie.title}
                  loading={index < 4 ? 'eager' : 'lazy'}
                />

                <span class="poster-play">
                  ▶
                </span>

                {movie.featured && (
                  <span
                    style="
                      position:absolute;
                      top:12px;
                      left:12px;
                      z-index:3;
                      padding:7px 10px;
                      border-radius:5px;
                      background:rgba(255,73,56,.92);
                      color:#fff;
                      font-size:10px;
                      font-weight:800;
                      letter-spacing:1px;
                    "
                  >
                    FEATURED
                  </span>
                )}

              </div>

              <h2 class="movie-title">
                {movie.title}
              </h2>

              <p class="movie-meta">
                {movie.year} · {movie.genre}
              </p>

            </a>
          ))}

        </div>
      ) : (
        <div class="empty-state">

          <div class="empty-icon">
            ✦
          </div>

          <h2>
            No movies here yet.
          </h2>

          <p>
            There are currently no movies in the
            {decodedGenre} genre.
          </p>

          <div
            style="
              display:flex;
              justify-content:center;
              gap:12px;
              flex-wrap:wrap;
              margin-top:26px;
            "
          >

            <a
              href="/genres"
              class="btn btn-primary"
            >
              ALL GENRES
            </a>

            <a
              href="/movies"
              class="btn btn-secondary"
            >
              ALL MOVIES
            </a>

          </div>

        </div>
      )
    }

  </section>

</Layout>
