---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Vault Access — REBELVAULT"
  description="Private REBELVAULT control access."
>
  <section class="vault-login">
    <div class="vault-login-card">

      <div class="vault-login-mark">
        <span>REBEL</span><strong>VAULT</strong>
      </div>

      <div class="eyebrow">
        RESTRICTED ACCESS
      </div>

      <h1>
        Vault Control
      </h1>

      <p class="vault-login-subtitle">
        Private access required.
      </p>

      <form id="login-form">
        <div class="form-group">
          <label for="password">
            Access Password
          </label>

          <input
            id="password"
            name="password"
            type="password"
            placeholder="Enter access password"
            autocomplete="current-password"
            required
          />
        </div>

        <button
          id="login-button"
          type="submit"
        >
          ENTER VAULT
        </button>

        <div
          id="login-message"
          class="login-message"
          aria-live="polite"
        ></div>
      </form>

      <a
        href="/"
        class="back-home"
      >
        ← BACK TO REBELVAULT
      </a>

    </div>
  </section>

  <script>
    const form =
      document.querySelector<HTMLFormElement>(
        '#login-form'
      );

    const password =
      document.querySelector<HTMLInputElement>(
        '#password'
      );

    const button =
      document.querySelector<HTMLButtonElement>(
        '#login-button'
      );

    const message =
      document.querySelector<HTMLDivElement>(
        '#login-message'
      );

    form?.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault();

        if (
          !password ||
          !button ||
          !message
        ) {
          return;
        }

        const value =
          password.value.trim();

        if (!value) {
          message.className =
            'login-message error';

          message.textContent =
            'Enter the access password.';

          password.focus();

          return;
        }

        button.disabled = true;
        button.textContent =
          'AUTHENTICATING...';

        message.className =
          'login-message';

        message.textContent = '';

        try {
          const response =
            await fetch(
              '/api/admin/login',
              {
                method: 'POST',
                headers: {
                  'Content-Type':
                    'application/json',

                  Accept:
                    'application/json',
                },

                credentials:
                  'same-origin',

                body: JSON.stringify({
                  password: value,
                }),
              }
            );

          let data: any = null;

          try {
            data =
              await response.json();
          } catch {
            data = null;
          }

          if (
            !response.ok ||
            !data?.success
          ) {
            throw new Error(
              data?.error ||
              'Authentication failed.'
            );
          }

          message.className =
            'login-message success';

          message.textContent =
            'Access granted.';

          window.location.replace(
            '/vault-control'
          );

        } catch (error) {
          message.className =
            'login-message error';

          message.textContent =
            error instanceof Error
              ? error.message
              : 'Authentication failed.';

          password.value = '';
          password.focus();

        } finally {
          button.disabled = false;
          button.textContent =
            'ENTER VAULT';
        }
      }
    );
  </script>

  <style>
    .vault-login {
      min-height: calc(100vh - 180px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 20px;
      background:
        radial-gradient(
          circle at 50% 20%,
          rgba(255,73,56,.08),
          transparent 35%
        );
    }

    .vault-login-card {
      width: min(440px, 100%);
      padding: 46px;
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 18px;
      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,.025),
          rgba(255,255,255,.008)
        ),
        #0d0f13;
      box-shadow:
        0 30px 100px rgba(0,0,0,.45);
    }

    .vault-login-mark {
      margin-bottom: 44px;
      font-size: 16px;
      font-weight: 900;
      letter-spacing: -0.5px;
    }

    .vault-login-mark span {
      color: #fff;
    }

    .vault-login-mark strong {
      color: #ff4938;
    }

    .vault-login-card .eyebrow {
      color: #ff4938;
    }

    .vault-login-card h1 {
      margin: 10px 0 0;
      color: #f4f5f6;
      font-size: clamp(40px, 8vw, 58px);
      line-height: .95;
      letter-spacing: -3px;
    }

    .vault-login-subtitle {
      margin: 16px 0 34px;
      color: #737881;
      font-size: 14px;
    }

    #login-form {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .form-group label {
      color: #dfe1e5;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.3px;
      text-transform: uppercase;
    }

    .form-group input {
      width: 100%;
      box-sizing: border-box;
      padding: 15px 16px;
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 8px;
      outline: none;
      background: #08090c;
      color: #fff;
      font: inherit;
      font-size: 14px;
      transition:
        border-color .2s ease,
        box-shadow .2s ease;
    }

    .form-group input::placeholder {
      color: #4e535b;
    }

    .form-group input:focus {
      border-color:
        rgba(255,73,56,.65);

      box-shadow:
        0 0 0 3px
        rgba(255,73,56,.08);
    }

    #login-button {
      width: 100%;
      margin-top: 4px;
      padding: 16px 20px;
      border: 0;
      border-radius: 8px;
      background: #ff4938;
      color: #fff;
      cursor: pointer;
      font: inherit;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.5px;
      transition:
        transform .2s ease,
        background .2s ease,
        opacity .2s ease;
    }

    #login-button:hover:not(:disabled) {
      transform: translateY(-2px);
      background: #ff5a4b;
    }

    #login-button:disabled {
      cursor: wait;
      opacity: .6;
    }

    .login-message {
      display: none;
      padding: 13px 15px;
      border-radius: 7px;
      font-size: 12px;
      line-height: 1.5;
    }

    .login-message.success,
    .login-message.error {
      display: block;
    }

    .login-message.success {
      border: 1px solid
        rgba(70,200,130,.2);

      background:
        rgba(70,200,130,.06);

      color: #7dd9a5;
    }

    .login-message.error {
      border: 1px solid
        rgba(255,73,56,.2);

      background:
        rgba(255,73,56,.06);

      color: #ff887c;
    }

    .back-home {
      display: block;
      margin-top: 30px;
      color: #626771;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.1px;
      text-align: center;
      transition: color .2s ease;
    }

    .back-home:hover {
      color: #ff4938;
    }

    @media (max-width: 600px) {
      .vault-login {
        min-height: calc(100vh - 140px);
        padding: 50px 12px;
      }

      .vault-login-card {
        padding: 32px 24px;
      }

      .vault-login-card h1 {
        letter-spacing: -2px;
      }
    }
  </style>
</Layout>
