---
import Layout from '../layouts/Layout.astro';
import { getMovies, getFeaturedMovie } from '../lib/movies';

const runtimeEnv = Astro.locals.runtime?.env;

if (!runtimeEnv?.DB) {
  throw new Error('D1 database binding DB is not configured.');
}

const db = runtimeEnv.DB;

const [movies, featuredMovie] = await Promise.all([
  getMovies(db),
  getFeaturedMovie(db),
]);

const trendingMovies = movies.slice(0, 8);

const latestMovies = movies.slice(0, 8);

const genres = [
  {
    name: 'Action',
    number: '01',
    description: 'Adrenaline, chaos and movies that never slow down.',
  },
  {
    name: 'Horror',
    number: '02',
    description: 'Dark stories, nightmares and things you should not watch alone.',
  },
  {
    name: 'Sci-Fi',
    number: '03',
    description: 'Future worlds, impossible technology and strange realities.',
  },
  {
    name: 'Thriller',
    number: '04',
    description: 'Suspense, paranoia and stories that keep you guessing.',
  },
  {
    name: 'Comedy',
    number: '05',
    description: 'Movies built for laughs, chaos and questionable decisions.',
  },
  {
    name: 'Drama',
    number: '06',
    description: 'Character-driven stories with something to say.',
  },
  {
    name: 'Crime',
    number: '07',
    description: 'Heists, criminals, detectives and morally grey characters.',
  },
  {
    name: 'Adventure',
    number: '08',
    description: 'Journeys, discoveries and worlds waiting to be explored.',
  },
  {
    name: 'Western',
    number: '09',
    description: 'Frontier stories, outlaws, lawmen and wide-open landscapes.',
  },
  {
    name: 'Documentary',
    number: '10',
    description: 'Real stories, true events and films that explore the world around us.',
  },
];
---

<Layout
  title="REBELVAULT — Movies Outside the Mainstream"
  description="Discover movies worth watching. Explore the REBELVAULT underground cinema."
>

  {
    featuredMovie ? (
      <section
        class="hero"
        style={`background-image: url("${featuredMovie.backdrop}")`}
      >

        <div class="hero-overlay"></div>

        <div class="hero-content">

          <div class="eyebrow">
            FEATURED FROM THE VAULT
          </div>

          <h1>
            {featuredMovie.title}
          </h1>

          <div class="hero-meta">
            <span>{featuredMovie.year}</span>
            <span>•</span>
            <span>{featuredMovie.genre}</span>
          </div>

          <p>
            {featuredMovie.description}
          </p>

          <div class="hero-actions">

            <a
              href="https://omg10.com/4/9027972"
              class="btn btn-primary"
            >
              ▶ WATCH MOVIE
            </a>

            <a
              href="/movies"
              class="btn btn-secondary"
            >
              BROWSE VAULT
            </a>

          </div>

        </div>

      </section>
    ) : (
      <section class="hero hero-empty">

        <div class="hero-overlay"></div>

        <div class="hero-content">

          <div class="eyebrow">
            WELCOME TO THE VAULT
          </div>

          <p>
           For the curious. The restless. The outsiders.
          </p>

          

        </div>

      </section>
    )
  }

  <section class="section">

    <div class="section-header">

      <div>
        <div class="eyebrow">
          WHAT'S MOVING
        </div>

        <h2 class="section-title">
          Trending Now
        </h2>
      </div>

      <a
        href="/trending"
        class="section-link"
      >
        View all →
      </a>

    </div>

    {
      trendingMovies.length > 0 ? (
        <div class="movie-grid">

          {trendingMovies.map((movie, index) => (
            <a
              href={`/movie/${movie.id}`}
              class="movie-card"
            >

              <div class="poster">

                <img
                  src={movie.poster}
                  alt={movie.title}
                  loading={index < 4 ? 'eager' : 'lazy'}
                />

                <span class="poster-play">
                  ▶
                </span>

              </div>

              <h3 class="movie-title">
                {movie.title}
              </h3>

              <p class="movie-meta">
                {movie.year} · {movie.genre}
              </p>

            </a>
          ))}

        </div>
      ) : (
        <div class="empty-state">

          <div class="empty-icon">
            ✦
          </div>

          <h2>
            The vault is empty.
          </h2>

          <p>
            Your first movie will appear here once it is published.
          </p>

        </div>
      )
    }

  </section>

  <section class="section section-dark">

    <div class="section-header">

      <div>
        <div class="eyebrow">
          FIND YOUR MOOD
        </div>

        <h2 class="section-title">
          Explore Genres
        </h2>
      </div>

      <a
        href="/genres"
        class="section-link"
      >
        All genres →
      </a>

    </div>

    <div class="genre-grid">

      {
        genres.map((genre) => (
          <a
            href={`/genres/${genre.name.toLowerCase()}`}
            class="genre-card"
          >

            <span class="genre-number">
              {genre.number}
            </span>

            <h3>
              {genre.name}
            </h3>

            <p
              style="
                margin:14px 0 0;
                max-width:300px;
                color:#8f949d;
                font-size:14px;
                line-height:1.6;
              "
            >
              {genre.description}
            </p>

            <span
              style="
                display:inline-block;
                margin-top:24px;
                color:#ff4938;
                font-size:11px;
                font-weight:800;
                letter-spacing:1.4px;
                text-transform:uppercase;
              "
            >
              Explore →
            </span>

          </a>
        ))
      }

    </div>

  </section>

  {
    latestMovies.length > 0 && (
      <section class="section">

        <div class="section-header">

          <div>
            <div class="eyebrow">
              JUST ADDED
            </div>

            <h2 class="section-title">
              Latest Movies
            </h2>
          </div>

          <a
            href="/movies"
            class="section-link"
          >
            View all →
          </a>

        </div>

        <div class="movie-grid">

          {latestMovies.map((movie) => (
            <a
              href={`/movie/${movie.id}`}
              class="movie-card"
            >

              <div class="poster">

                <img
                  src={movie.poster}
                  alt={movie.title}
                  loading="lazy"
                />

                <span class="poster-play">
                  ▶
                </span>

              </div>

              <h3 class="movie-title">
                {movie.title}
              </h3>

              <p class="movie-meta">
                {movie.year} · {movie.genre}
              </p>

            </a>
          ))}

        </div>

      </section>
    )
  }

  <section class="section">

    <div class="random-page">

      <div class="random-inner">

        <div class="eyebrow">
          CAN'T DECIDE?
        </div>

        <h2>
          Let REBELVAULT
          choose for you.
        </h2>

        <p>
          No endless scrolling. No algorithm telling you what to watch.
          Just pick a random movie and press play.
        </p>

        <a
          href="/random"
          class="btn btn-accent"
        >
          🎲 RANDOM MOVIE
        </a>

      </div>

    </div>

  </section>

</Layout>
