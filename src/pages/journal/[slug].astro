---
import Layout from '../../layouts/Layout.astro';
import {
  getJournalArticleBySlug,
  renderJournalContent,
} from '../../lib/journal';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/journal', 302);
}

const env = Astro.locals.runtime.env;
const article = await getJournalArticleBySlug(env.DB, slug);

if (!article || !article.published) {
  return Astro.redirect('/journal', 302);
}

const renderedContent = renderJournalContent(article.content);

const title = `${article.title} — REBELVAULT Journal`;
const description =
  article.excerpt ||
  `Read ${article.title} on the REBELVAULT Journal.`;

const publishedDate = new Date(article.createdAt).toLocaleDateString(
  'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
);
---

<Layout title={title} description={description}>
  <article class="article-page">
    {article.coverImage && (
      <div class="article-cover">
        <img
          src={article.coverImage}
          alt={article.title}
          loading="eager"
        />
      </div>
    )}

    <div class="article-container">
      <div class="article-meta">
        <span>{article.category}</span>
        <span>•</span>
        <time datetime={article.createdAt}>
          {publishedDate}
        </time>
      </div>

      <h1>{article.title}</h1>

      {article.excerpt && (
        <p class="article-excerpt">
          {article.excerpt}
        </p>
      )}

      <div
        class="article-content"
        set:html={renderedContent}
      />

      <div class="article-footer">
        <a href="/journal" class="back-link">
          ← Back to Journal
        </a>
      </div>
    </div>
  </article>

  <style>
    .article-page {
      min-height: 100vh;
      padding-bottom: 100px;
    }

    .article-cover {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 24px 0;
    }

    .article-cover img {
      display: block;
      width: 100%;
      max-height: 560px;
      object-fit: cover;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .article-container {
      width: min(860px, calc(100% - 40px));
      margin: 0 auto;
      padding-top: 48px;
    }

    .article-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      color: #777d87;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .article-meta span:first-child {
      color: #d6ff3f;
    }

    h1 {
      margin: 0;
      color: #f5f6f7;
      font-size: clamp(36px, 6vw, 68px);
      font-weight: 900;
      line-height: 0.98;
      letter-spacing: -2.5px;
    }

    .article-excerpt {
      margin: 26px 0 0;
      color: #9da3ad;
      font-size: 20px;
      line-height: 1.6;
    }

    .article-content {
      margin-top: 48px;
      color: #c7cbd1;
      font-size: 18px;
      line-height: 1.85;
    }

    .article-content :global(h2) {
      margin: 56px 0 20px;
      color: #f5f6f7;
      font-size: 30px;
      line-height: 1.15;
      letter-spacing: -0.8px;
    }

    .article-content :global(h3) {
      margin: 42px 0 16px;
      color: #f5f6f7;
      font-size: 24px;
      line-height: 1.2;
    }

    .article-content :global(p) {
      margin: 0 0 28px;
    }

    .article-content :global(strong) {
      color: #f5f6f7;
      font-weight: 800;
    }

    .article-content :global(em) {
      color: #e0e3e7;
    }

    .article-content :global(a) {
      color: #d6ff3f;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .article-content :global(img) {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
      margin: 36px 0;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .article-footer {
      margin-top: 64px;
      padding-top: 28px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      color: #d6ff3f;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 1px;
      text-decoration: none;
      text-transform: uppercase;
    }

    .back-link:hover {
      color: #fff;
    }

    @media (max-width: 700px) {
      .article-cover {
        padding: 20px 16px 0;
      }

      .article-cover img {
        max-height: 360px;
        border-radius: 10px;
      }

      .article-container {
        width: min(100% - 32px, 860px);
        padding-top: 34px;
      }

      h1 {
        font-size: clamp(34px, 11vw, 52px);
        letter-spacing: -1.8px;
      }

      .article-excerpt {
        font-size: 18px;
      }

      .article-content {
        margin-top: 38px;
        font-size: 17px;
        line-height: 1.8;
      }
    }
  </style>
</Layout>
