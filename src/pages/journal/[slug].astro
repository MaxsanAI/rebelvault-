---
import Layout from '../../layouts/Layout.astro';
import {
  getJournalArticleBySlug,
  renderJournalContent,
} from '../../../src/lib/journal';

const slug = Astro.params.slug ?? '';
const db = Astro.locals.runtime.env.DB;

const article = db
  ? await getJournalArticleBySlug(db, slug, true)
  : null;

if (!article) {
  return Astro.redirect('/journal', 302);
}

const renderedContent = renderJournalContent(
  article.content
);
---

<Layout
  title={`${article.title} — REBELVAULT Journal`}
  description={
    article.excerpt ||
    `${article.title} — REBELVAULT Journal`
  }
>
  <article class="journal-article">
    <header class="article-header">
      <a href="/journal" class="back-link">
        ← JOURNAL
      </a>

      <div class="article-meta">
        <span>{article.category}</span>

        <span>
          {new Date(
            article.createdAt
          ).toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </span>
      </div>

      <h1>{article.title}</h1>

      {article.excerpt && (
        <p class="lead">
          {article.excerpt}
        </p>
      )}
    </header>

    {article.coverImage && (
      <div class="cover">
        <img
          src={article.coverImage}
          alt={article.title}
        />
      </div>
    )}

    <div
      class="article-content"
      set:html={renderedContent}
    />

    <footer class="article-footer">
      <a href="/journal">
        ← BACK TO JOURNAL
      </a>
    </footer>
  </article>
</Layout>

<style>
  .journal-article {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
    padding: 70px 0 110px;
  }

  .article-header {
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: #737983;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #fff;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    color: #ff3b30;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .article-meta span + span::before {
    content: '•';
    margin-right: 14px;
    color: #444850;
  }

  .article-header h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 950;
    letter-spacing: -3px;
    line-height: 0.98;
  }

  .lead {
    max-width: 760px;
    margin: 26px 0 0;
    color: #8b919b;
    font-size: 20px;
    line-height: 1.65;
  }

  .cover {
    width: 100%;
    margin-bottom: 50px;
    overflow: hidden;
    border: 1px solid #1d2027;
    background: #0d0f13;
  }

  .cover img {
    width: 100%;
    max-height: 560px;
    display: block;
    object-fit: cover;
  }

  .article-content {
    max-width: 760px;
    margin: 0 auto;
    color: #c4c8cf;
    font-size: 18px;
    line-height: 1.9;
  }

  .article-content :global(p) {
    margin: 0 0 28px;
  }

  .article-content :global(h2) {
    margin: 58px 0 20px;
    color: #fff;
    font-size: 32px;
    line-height: 1.15;
  }

  .article-content :global(h3) {
    margin: 46px 0 16px;
    color: #fff;
    font-size: 24px;
    line-height: 1.2;
  }

  .article-content :global(a) {
    color: #ff5147;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-content :global(strong) {
    color: #fff;
    font-weight: 800;
  }

  .article-content :global(em) {
    color: #d6d9de;
  }

  .article-content :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 38px 0;
    border: 1px solid #1d2027;
  }

  .article-footer {
    max-width: 760px;
    margin: 65px auto 0;
    padding-top: 28px;
    border-top: 1px solid #1d2027;
  }

  .article-footer a {
    color: #ff3b30;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .journal-article {
      width: min(100% - 28px, 900px);
      padding-top: 45px;
    }

    .article-header h1 {
      letter-spacing: -2px;
    }

    .lead {
      font-size: 17px;
    }

    .article-content {
      font-size: 17px;
      line-height: 1.8;
    }
  }
</style>
