---
import Layout from '../layouts/Layout.astro';
import { getMovies } from '../lib/movies';

const runtimeEnv = Astro.locals.runtime?.env;

if (!runtimeEnv?.DB) {
  throw new Error('D1 database binding DB is not configured.');
}

const movies = await getMovies(runtimeEnv.DB);
---

<Layout
  title="Movies — REBELVAULT"
  description="Browse the REBELVAULT movie collection."
>

  <section class="section page-section">

    <div class="section-header">

      <div>
        <div class="eyebrow">
          THE VAULT
        </div>

        <h1 class="section-title">
          All Movies
        </h1>
      </div>

      <span class="movie-count">
        {movies.length}
        {movies.length === 1 ? ' movie' : ' movies'}
      </span>

    </div>

    {
      movies.length > 0 ? (
        <div class="movie-grid">

          {movies.map((movie, index) => (
            <a
              href={`/movie/${movie.id}`}
              class="movie-card"
            >

              <div class="poster">

                <img
                  src={movie.poster}
                  alt={movie.title}
                  loading={index < 4 ? 'eager' : 'lazy'}
                />

                <span class="poster-play">
                  ▶
                </span>

                {movie.featured && (
                  <span
                    style="
                      position:absolute;
                      top:12px;
                      left:12px;
                      z-index:3;
                      padding:7px 10px;
                      border-radius:5px;
                      background:rgba(255,73,56,.92);
                      color:#fff;
                      font-size:10px;
                      font-weight:800;
                      letter-spacing:1px;
                    "
                  >
                    FEATURED
                  </span>
                )}

              </div>

              <h2 class="movie-title">
                {movie.title}
              </h2>

              <p class="movie-meta">
                {movie.year} · {movie.genre}
              </p>

            </a>
          ))}

        </div>
      ) : (
        <div class="empty-state">

          <div class="empty-icon">
            ✦
          </div>

          <h2>
            The vault is empty.
          </h2>

          <p>
            Your movie collection will appear here once you publish
            your first title through Vault Control.
          </p>

          <a
            href="/"
            class="btn btn-primary"
          >
            BACK TO HOME
          </a>

        </div>
      )
    }

  </section>

</Layout>
