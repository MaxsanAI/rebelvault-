---
import Layout from '../../layouts/Layout.astro';
import {
  getMovieById,
  getMovies,
} from '../../lib/movies';

const runtimeEnv = Astro.locals.runtime?.env;

if (!runtimeEnv?.DB) {
  throw new Error('D1 database binding DB is not configured.');
}

const db = runtimeEnv.DB;

const movieId = String(Astro.params.id ?? '');

const [movie, allMovies] = await Promise.all([
  getMovieById(db, movieId),
  getMovies(db),
]);

if (!movie) {
  Astro.response.status = 404;
}

const relatedMovies = movie
  ? allMovies
      .filter(
        (item) =>
          item.id !== movie.id &&
          item.genre.toLowerCase() === movie.genre.toLowerCase()
      )
      .slice(0, 4)
  : [];

const monetagUrl = 'https://omg10.com/4/9027972';
---

<Layout
  title={
    movie
      ? `${movie.title} — REBELVAULT`
      : 'Movie Not Found — REBELVAULT'
  }
  description={
    movie
      ? movie.description
      : 'The requested movie could not be found.'
  }
>

  {
    movie ? (
      <>
        <section
          class="watch-page"
          style={`background-image:url("${movie.backdrop}")`}
        >

          <div class="watch-backdrop"></div>

          <div class="watch-inner">

            <a
              href="/movies"
              class="back-link"
            >
              ← BACK TO MOVIES
            </a>

            <div class="watch-layout">

              <div class="watch-poster">

                <img
                  src={movie.poster}
                  alt={movie.title}
                />

              </div>

              <div class="watch-details">

                <div class="eyebrow">
                  REBELVAULT
                </div>

                <h1>
                  {movie.title}
                </h1>

                <div class="watch-meta">

                  <span>
                    {movie.year}
                  </span>

                  <span>•</span>

                  <span>
                    {movie.genre}
                  </span>

                </div>

                <p class="watch-description">
                  {movie.description}
                </p>

                <div class="watch-cta">

                  <a
                    href={monetagUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    ▶ WATCH MOVIE
                  </a>

                  <span class="watch-note">
                    Opens the streaming link in a new tab.
                  </span>

                </div>

              </div>

            </div>

          </div>

        </section>

        <section class="section">

          <div class="section-header">

            <div>
              <div class="eyebrow">
                NOW PLAYING
              </div>

              <h2 class="section-title">
                Watch {movie.title}
              </h2>
            </div>

          </div>

          <div class="player-container">

            <iframe
              src={movie.embed}
              title={`Watch ${movie.title}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>

          </div>

          <div class="watch-bottom-cta">

            <p>
              Enjoy the movie?
            </p>

            <a
              href={monetagUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-accent"
            >
              CONTINUE WATCHING →
            </a>

          </div>

        </section>

        {
          relatedMovies.length > 0 && (
            <section class="section">

              <div class="section-header">

                <div>
                  <div class="eyebrow">
                    MORE FROM THE VAULT
                  </div>

                  <h2 class="section-title">
                    You Might Also Like
                  </h2>
                </div>

                <a
                  href={`/genres/${encodeURIComponent(movie.genre.toLowerCase())}`}
                  class="section-link"
                >
                  More {movie.genre} →
                </a>

              </div>

              <div class="movie-grid">

                {relatedMovies.map((relatedMovie) => (
                  <a
                    href={`/movie/${relatedMovie.id}`}
                    class="movie-card"
                  >

                    <div class="poster">

                      <img
                        src={relatedMovie.poster}
                        alt={relatedMovie.title}
                        loading="lazy"
                      />

                      <span class="poster-play">
                        ▶
                      </span>

                    </div>

                    <h3 class="movie-title">
                      {relatedMovie.title}
                    </h3>

                    <p class="movie-meta">
                      {relatedMovie.year} · {relatedMovie.genre}
                    </p>

                  </a>
                ))}

              </div>

            </section>
          )
        }
      </>
    ) : (
      <section class="section page-section">

        <div class="empty-state">

          <div class="empty-icon">
            ✕
          </div>

          <h1>
            Movie not found.
          </h1>

          <p>
            This movie is not currently available in the vault.
          </p>

          <a
            href="/movies"
            class="btn btn-primary"
          >
            BROWSE MOVIES
          </a>

        </div>

      </section>
    )
  }

  <style>
    .watch-page {
      position: relative;
      min-height: 620px;
      display: flex;
      align-items: flex-end;
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }

    .watch-backdrop {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          rgba(8, 9, 12, 0.98) 0%,
          rgba(8, 9, 12, 0.86) 42%,
          rgba(8, 9, 12, 0.48) 75%,
          rgba(8, 9, 12, 0.78) 100%
        ),
        linear-gradient(
          0deg,
          #08090c 0%,
          transparent 48%
        );
    }

    .watch-inner {
      position: relative;
      z-index: 2;
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
      padding: 70px 0 90px;
    }

    .watch-layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 650px);
      gap: 48px;
      align-items: end;
      margin-top: 38px;
    }

    .watch-poster {
      width: 260px;
      aspect-ratio: 2 / 3;
      overflow: hidden;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    }

    .watch-poster img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .watch-details h1 {
      margin: 10px 0 18px;
      max-width: 850px;
      color: #fff;
      font-size: clamp(42px, 6vw, 76px);
      line-height: 0.95;
      letter-spacing: -3px;
    }

    .watch-meta {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 24px;
      color: #b4bac3;
      font-size: 13px;
      font-weight: 700;
    }

    .watch-description {
      max-width: 680px;
      margin: 0;
      color: #aeb3bc;
      font-size: 16px;
      line-height: 1.75;
    }

    .watch-cta {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .watch-note {
      color: #737983;
      font-size: 11px;
      line-height: 1.5;
    }

    .back-link {
      color: #9298a2;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: #fff;
    }

    .player-container {
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      background: #050506;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    }

    .player-container iframe {
      width: 100%;
      height: 100%;
      display: block;
      border: 0;
    }

    .watch-bottom-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      margin-top: 28px;
      text-align: center;
    }

    .watch-bottom-cta p {
      margin: 0;
      color: #8f949d;
      font-size: 13px;
    }

    @media (max-width: 850px) {
      .watch-page {
        min-height: auto;
      }

      .watch-inner {
        width: min(100% - 36px, 680px);
        padding: 50px 0 65px;
      }

      .watch-layout {
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 28px;
      }

      .watch-poster {
        width: 180px;
      }

      .watch-details h1 {
        font-size: clamp(34px, 8vw, 56px);
        letter-spacing: -2px;
      }
    }

    @media (max-width: 620px) {
      .watch-layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .watch-poster {
        width: min(220px, 70vw);
      }

      .watch-details h1 {
        font-size: 42px;
      }

      .watch-description {
        font-size: 14px;
      }

      .watch-cta {
        align-items: stretch;
        flex-direction: column;
      }

      .watch-cta .btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>

</Layout>
