---
import Layout from '../../layouts/Layout.astro';
import {
  getMovieById,
  getMovies,
} from '../../lib/movies';

const runtimeEnv = Astro.locals.runtime?.env;

if (!runtimeEnv?.DB) {
  throw new Error('D1 database binding DB is not configured.');
}

const db = runtimeEnv.DB;

const movieId = String(Astro.params.id ?? '');

const [movie, allMovies] = await Promise.all([
  getMovieById(db, movieId),
  getMovies(db),
]);

if (!movie) {
  Astro.response.status = 404;
}

const relatedMovies = movie
  ? allMovies
      .filter(
        (item) =>
          item.id !== movie.id &&
          item.genre.toLowerCase() === movie.genre.toLowerCase()
      )
      .slice(0, 4)
  : [];

const monetagUrl = 'https://omg10.com/4/9027972';
---

<Layout
  title={
    movie
      ? `${movie.title} — REBELVAULT`
      : 'Movie Not Found — REBELVAULT'
  }
  description={
    movie
      ? movie.description
      : 'The requested movie could not be found.'
  }
>

  {
    movie ? (
      <>
        <section
          class="watch-page"
          style={`background-image:url("${movie.backdrop}")`}
        >

          <div class="watch-backdrop"></div>

          <div class="watch-inner">

            <a
              href="/movies"
              class="back-link"
            >
              ← BACK TO MOVIES
            </a>

            <div class="watch-layout">

              <div class="watch-poster">

                <img
                  src={movie.poster}
                  alt={movie.title}
                />

              </div>

              <div class="watch-details">

                <div class="eyebrow">
                  REBELVAULT
                </div>

                <h1>
                  {movie.title}
                </h1>

                <div class="watch-meta">

                  <span>
                    {movie.year}
                  </span>

                  <span>•</span>

                  <span>
                    {movie.genre}
                  </span>

                </div>

                <p class="watch-description">
                  {movie.description}
                </p>

                <div class="watch-cta">

                  <a
                    href={monetagUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    ▶ WATCH MOVIE
                  </a>

                  <span class="watch-note">
                    Opens the streaming link in a new tab.
                  </span>

                </div>

              </div>

            </div>

          </div>

        </section>

        <section class="section">

          <div class="section-header">

            <div>
              <div class="eyebrow">
                NOW PLAYING
              </div>

              <h2 class="section-title">
                Watch {movie.title}
              </h2>
            </div>

          </div>

          <div class="player-container" id="movie-player">

            <iframe
              src={movie.embed}
              title={`Watch ${movie.title}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
              allowfullscreen
            ></iframe>

            <button
              type="button"
              class="player-fullscreen-btn"
              id="player-fullscreen"
              aria-label="Open movie player fullscreen"
              hidden
            >
              ⛶ FULLSCREEN
            </button>

          </div>

          <button
            type="button"
            class="player-fullscreen-close"
            id="player-fullscreen-close"
            hidden
            aria-label="Exit fullscreen"
          >
            ✕ EXIT
          </button>

          <div class="watch-bottom-cta">

            <p>
              Enjoy the movie?
            </p>

            <a
              href={monetagUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-accent"
            >
              CONTINUE WATCHING →
            </a>

          </div>

        </section>

        {
          relatedMovies.length > 0 && (
            <section class="section">

              <div class="section-header">

                <div>
                  <div class="eyebrow">
                    MORE FROM THE VAULT
                  </div>

                  <h2 class="section-title">
                    You Might Also Like
                  </h2>
                </div>

                <a
                  href={`/genres/${encodeURIComponent(movie.genre.toLowerCase())}`}
                  class="section-link"
                >
                  More {movie.genre} →
                </a>

              </div>

              <div class="movie-grid">

                {relatedMovies.map((relatedMovie) => (
                  <a
                    href={`/movie/${relatedMovie.id}`}
                    class="movie-card"
                  >

                    <div class="poster">

                      <img
                        src={relatedMovie.poster}
                        alt={relatedMovie.title}
                        loading="lazy"
                      />

                      <span class="poster-play">
                        ▶
                      </span>

                    </div>

                    <h3 class="movie-title">
                      {relatedMovie.title}
                    </h3>

                    <p class="movie-meta">
                      {relatedMovie.year} · {relatedMovie.genre}
                    </p>

                  </a>
                ))}

              </div>

            </section>
          )
        }
      </>
    ) : (
      <section class="section page-section">

        <div class="empty-state">

          <div class="empty-icon">
            ✕
          </div>

          <h1>
            Movie not found.
          </h1>

          <p>
            This movie is not currently available in the vault.
          </p>

          <a
            href="/movies"
            class="btn btn-primary"
          >
            BROWSE MOVIES
          </a>

        </div>

      </section>
    )
  }

  <script is:inline>
    (() => {
      const userAgent = navigator.userAgent || '';

      /*
       * IMPORTANT:
       * Telegram integration is completely isolated.
       * Nothing below runs in normal browsers.
       */
      const isTelegramWebView =
        /Telegram/i.test(userAgent) ||
        /TelegramBot/i.test(userAgent);

      if (!isTelegramWebView) {
        return;
      }

      const player = document.getElementById('movie-player');
      const fullscreenButton =
        document.getElementById('player-fullscreen');
      const closeButton =
        document.getElementById('player-fullscreen-close');

      if (!player || !fullscreenButton || !closeButton) {
        return;
      }

      fullscreenButton.hidden = false;

      let telegramWebApp = null;

      const showCloseButton = () => {
        closeButton.hidden = false;
      };

      const hideCloseButton = () => {
        closeButton.hidden = true;
      };

      const loadTelegramSDK = () => {
        return new Promise((resolve) => {
          if (window.Telegram?.WebApp) {
            resolve(window.Telegram.WebApp);
            return;
          }

          const existingScript = document.querySelector(
            'script[data-rebelvault-telegram-sdk]'
          );

          if (existingScript) {
            existingScript.addEventListener('load', () => {
              resolve(window.Telegram?.WebApp || null);
            });

            existingScript.addEventListener('error', () => {
              resolve(null);
            });

            return;
          }

          const script = document.createElement('script');

          script.src =
            'https://telegram.org/js/telegram-web-app.js?63';

          script.async = true;
          script.dataset.rebelvaultTelegramSdk = 'true';

          script.onload = () => {
            resolve(window.Telegram?.WebApp || null);
          };

          script.onerror = () => {
            resolve(null);
          };

          document.head.appendChild(script);
        });
      };

      const setupTelegram = async () => {
        telegramWebApp = await loadTelegramSDK();

        if (!telegramWebApp) {
          return;
        }

        try {
          telegramWebApp.ready();
        } catch {
          // Ignore Telegram initialization errors.
        }

        try {
          telegramWebApp.expand();
        } catch {
          // Ignore Telegram expand errors.
        }

        try {
          if (telegramWebApp.setHeaderColor) {
            telegramWebApp.setHeaderColor('#08090c');
          }
        } catch {
          // Ignore unsupported Telegram header APIs.
        }

        try {
          if (telegramWebApp.setBackgroundColor) {
            telegramWebApp.setBackgroundColor('#08090c');
          }
        } catch {
          // Ignore unsupported Telegram background APIs.
        }

        try {
          if (telegramWebApp.onEvent) {
            telegramWebApp.onEvent(
              'fullscreenChanged',
              () => {
                if (telegramWebApp?.isFullscreen) {
                  document.body.classList.add(
                    'telegram-player-fullscreen'
                  );

                  showCloseButton();
                } else {
                  document.body.classList.remove(
                    'telegram-player-fullscreen'
                  );

                  document.body.classList.remove(
                    'player-cinema-mode'
                  );

                  hideCloseButton();
                }
              }
            );

            telegramWebApp.onEvent(
              'fullscreenFailed',
              () => {
                /*
                 * Telegram refused native fullscreen.
                 * Keep the cinema-mode fallback.
                 */
                document.body.classList.add(
                  'player-cinema-mode'
                );

                showCloseButton();
              }
            );
          }
        } catch {
          // Ignore unsupported Telegram event APIs.
        }
      };

      const enterFullscreen = async () => {
        /*
         * Activate our fallback immediately.
         * This also makes the player fill the WebView if
         * Telegram's native fullscreen API is unavailable.
         */
        document.body.classList.add(
          'player-cinema-mode'
        );

        showCloseButton();

        if (!telegramWebApp) {
          telegramWebApp = await loadTelegramSDK();
        }

        /*
         * THIS is the important part.
         *
         * Telegram's native Mini App fullscreen mode is
         * what removes the normal Mini App header area.
         */
        try {
          if (
            telegramWebApp &&
            typeof telegramWebApp.requestFullscreen ===
              'function'
          ) {
            telegramWebApp.requestFullscreen();

            return;
          }
        } catch {
          // Continue to browser fallback.
        }

        /*
         * Browser Fullscreen API fallback.
         */
        try {
          if (
            document.documentElement.requestFullscreen
          ) {
            await document.documentElement.requestFullscreen();
          }
        } catch {
          // Cinema mode remains active.
        }
      };

      const exitFullscreen = async () => {
        /*
         * Tell Telegram to leave its native Mini App
         * fullscreen mode first.
         */
        try {
          if (
            telegramWebApp &&
            typeof telegramWebApp.exitFullscreen ===
              'function'
          ) {
            telegramWebApp.exitFullscreen();
          }
        } catch {
          // Ignore Telegram exit errors.
        }

        /*
         * Also leave browser fullscreen if it was used.
         */
        try {
          if (
            document.fullscreenElement &&
            document.exitFullscreen
          ) {
            await document.exitFullscreen();
          }
        } catch {
          // Ignore browser fullscreen exit errors.
        }

        document.body.classList.remove(
          'telegram-player-fullscreen'
        );

        document.body.classList.remove(
          'player-cinema-mode'
        );

        hideCloseButton();
      };

      fullscreenButton.addEventListener(
        'click',
        enterFullscreen
      );

      closeButton.addEventListener(
        'click',
        exitFullscreen
      );

      document.addEventListener(
        'fullscreenchange',
        () => {
          if (document.fullscreenElement) {
            showCloseButton();
          }
        }
      );

      setupTelegram();
    })();
  </script>

  <style>
    .watch-page {
      position: relative;
      min-height: 620px;
      display: flex;
      align-items: flex-end;
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }

    .watch-backdrop {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          rgba(8, 9, 12, 0.98) 0%,
          rgba(8, 9, 12, 0.86) 42%,
          rgba(8, 9, 12, 0.48) 75%,
          rgba(8, 9, 12, 0.78) 100%
        ),
        linear-gradient(
          0deg,
          #08090c 0%,
          transparent 48%
        );
    }

    .watch-inner {
      position: relative;
      z-index: 2;
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
      padding: 70px 0 90px;
    }

    .watch-layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 650px);
      gap: 48px;
      align-items: end;
      margin-top: 38px;
    }

    .watch-poster {
      width: 260px;
      aspect-ratio: 2 / 3;
      overflow: hidden;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    }

    .watch-poster img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .watch-details h1 {
      margin: 10px 0 18px;
      max-width: 850px;
      color: #fff;
      font-size: clamp(42px, 6vw, 76px);
      line-height: 0.95;
      letter-spacing: -3px;
    }

    .watch-meta {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 24px;
      color: #b4bac3;
      font-size: 13px;
      font-weight: 700;
    }

    .watch-description {
      max-width: 680px;
      margin: 0;
      color: #aeb3bc;
      font-size: 16px;
      line-height: 1.75;
    }

    .watch-cta {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .watch-note {
      color: #737983;
      font-size: 11px;
      line-height: 1.5;
    }

    .back-link {
      color: #9298a2;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: #fff;
    }

    .player-container {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      background: #050506;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    }

    .player-container iframe {
      width: 100%;
      height: 100%;
      display: block;
      border: 0;
    }

    .player-fullscreen-btn,
    .player-fullscreen-close {
      appearance: none;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(8, 9, 12, 0.82);
      color: #fff;
      font: inherit;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.8px;
      cursor: pointer;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .player-fullscreen-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      z-index: 5;
      padding: 10px 13px;
      border-radius: 7px;
    }

    .player-fullscreen-close {
      position: fixed;
      top: max(14px, env(safe-area-inset-top));
      right: 14px;
      z-index: 2147483647;
      padding: 10px 13px;
      border-radius: 7px;
    }

    .player-fullscreen-btn:hover,
    .player-fullscreen-close:hover {
      background: rgba(255, 255, 255, 0.12);
    }

    .player-container:fullscreen {
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-width: none;
      aspect-ratio: auto;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: #000;
    }

    .player-container:fullscreen iframe {
      width: 100%;
      height: 100%;
    }

    body.player-cinema-mode {
      overflow: hidden;
    }

    body.player-cinema-mode .player-container {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-width: none;
      aspect-ratio: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: #000;
    }

    body.player-cinema-mode .player-container iframe {
      width: 100%;
      height: 100%;
    }

    /*
     * Telegram native fullscreen mode.
     * Keep the page itself locked to the viewport.
     */
    body.telegram-player-fullscreen {
      overflow: hidden;
      width: 100%;
      height: 100%;
      min-height: 100%;
    }

    body.telegram-player-fullscreen .player-container {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-width: none;
      aspect-ratio: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: #000;
    }

    body.telegram-player-fullscreen .player-container iframe {
      width: 100%;
      height: 100%;
    }

    .watch-bottom-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      margin-top: 28px;
      text-align: center;
    }

    .watch-bottom-cta p {
      margin: 0;
      color: #8f949d;
      font-size: 13px;
    }

    @media (max-width: 850px) {
      .watch-page {
        min-height: auto;
      }

      .watch-inner {
        width: min(100% - 36px, 680px);
        padding: 50px 0 65px;
      }

      .watch-layout {
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 28px;
      }

      .watch-poster {
        width: 180px;
      }

      .watch-details h1 {
        font-size: clamp(34px, 8vw, 56px);
        letter-spacing: -2px;
      }
    }

    @media (max-width: 620px) {
      .watch-layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .watch-poster {
        width: min(220px, 70vw);
      }

      .watch-details h1 {
        font-size: 42px;
      }

      .watch-description {
        font-size: 14px;
      }

      .watch-cta {
        align-items: stretch;
        flex-direction: column;
      }

      .watch-cta .btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>

</Layout>
