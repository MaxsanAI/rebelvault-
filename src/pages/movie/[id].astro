---
import Layout from '../../layouts/Layout.astro';
import {
  getMovieById,
  getMovies,
} from '../../lib/movies';

const runtimeEnv = Astro.locals.runtime?.env;

if (!runtimeEnv?.DB) {
  throw new Error('D1 database binding DB is not configured.');
}

const db = runtimeEnv.DB;

const movieId = String(Astro.params.id ?? '');

const [movie, allMovies] = await Promise.all([
  getMovieById(db, movieId),
  getMovies(db),
]);

if (!movie) {
  Astro.response.status = 404;
}

const relatedMovies = movie
  ? allMovies
      .filter(
        (item) =>
          item.id !== movie.id &&
          item.genre.toLowerCase() === movie.genre.toLowerCase()
      )
      .slice(0, 4)
  : [];

const monetagUrl = 'https://omg10.com/4/9027972';
---

<Layout
  title={
    movie
      ? `${movie.title} — REBELVAULT`
      : 'Movie Not Found — REBELVAULT'
  }
  description={
    movie
      ? movie.description
      : 'The requested movie could not be found.'
  }
>

  {
    movie ? (
      <>
        <section
          class="watch-page"
          style={`background-image:url("${movie.backdrop}")`}
        >

          <div class="watch-backdrop"></div>

          <div class="watch-inner">

            <a
              href="/movies"
              class="back-link"
            >
              ← BACK TO MOVIES
            </a>

            <div class="watch-layout">

              <div class="watch-poster">

                <img
                  src={movie.poster}
                  alt={movie.title}
                />

              </div>

              <div class="watch-details">

                <div class="eyebrow">
                  REBELVAULT
                </div>

                <h1>
                  {movie.title}
                </h1>

                <div class="watch-meta">

                  <span>
                    {movie.year}
                  </span>

                  <span>•</span>

                  <span>
                    {movie.genre}
                  </span>

                </div>

                <p class="watch-description">
                  {movie.description}
                </p>

                <div class="watch-cta">

                  <a
                    href={monetagUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    ▶ WATCH MOVIE
                  </a>

                  <span class="watch-note">
                    Opens the streaming link in a new tab.
                  </span>

                </div>

              </div>

            </div>

          </div>

        </section>

        <section class="section">

          <div class="section-header">

            <div>
              <div class="eyebrow">
                NOW PLAYING
              </div>

              <h2 class="section-title">
                Watch {movie.title}
              </h2>
            </div>

          </div>

          <div
            class="player-container"
            id="movie-player"
          >

            <iframe
              src={movie.embed}
              title={`Watch ${movie.title}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
              allowfullscreen
            ></iframe>

            <!-- Small RebelVault promo -->
            <div
              class="rebelvault-promo"
              id="rebelvault-promo"
              aria-hidden="true"
            >
              <div class="rebelvault-promo-copy">

                <span class="rebelvault-promo-brand">
                  🎬 REBELVAULT
                </span>

                <span class="rebelvault-promo-text">
                  🍿 NEW MOVIE EVERY DAY
                </span>

              </div>

              <button
                type="button"
                class="rebelvault-promo-close"
                id="rebelvault-promo-close"
                aria-label="Close promotion"
              >
                ×
              </button>
            </div>

            <!-- Final support CTA -->
            <div
              class="rebelvault-support"
              id="rebelvault-support"
              aria-hidden="true"
            >
              <button
                type="button"
                class="rebelvault-support-close"
                id="rebelvault-support-close"
                aria-label="Close support message"
              >
                ×
              </button>

              <div class="rebelvault-support-title">
                🎬 <strong>ENJOYED THE MOVIE?</strong>
              </div>

              <div class="rebelvault-support-text">
                Help keep REBELVAULT running.
              </div>

              <div class="rebelvault-support-text">
                ❤️ Support the site by checking out our sponsor.
              </div>

              <a
                href={monetagUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rebelvault-support-link"
              >
                👉 CLICK TO SUPPORT REBELVAULT
              </a>
            </div>

            <button
              type="button"
              class="player-fullscreen-btn"
              id="player-fullscreen"
              aria-label="Open movie player fullscreen"
              hidden
            >
              ⛶ FULLSCREEN
            </button>

          </div>

          <button
            type="button"
            class="player-fullscreen-close"
            id="player-fullscreen-close"
            hidden
            aria-label="Exit fullscreen"
          >
            ✕ EXIT
          </button>

          <div class="watch-bottom-cta">

            <p>
              Enjoy the movie?
            </p>

            <a
              href={monetagUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-accent"
            >
              CONTINUE WATCHING →
            </a>

          </div>

        </section>

        {
          relatedMovies.length > 0 && (
            <section class="section">

              <div class="section-header">

                <div>
                  <div class="eyebrow">
                    MORE FROM THE VAULT
                  </div>

                  <h2 class="section-title">
                    You Might Also Like
                  </h2>
                </div>

                <a
                  href={`/genres/${encodeURIComponent(movie.genre.toLowerCase())}`}
                  class="section-link"
                >
                  More {movie.genre} →
                </a>

              </div>

              <div class="movie-grid">

                {relatedMovies.map((relatedMovie) => (
                  <a
                    href={`/movie/${relatedMovie.id}`}
                    class="movie-card"
                  >

                    <div class="poster">

                      <img
                        src={relatedMovie.poster}
                        alt={relatedMovie.title}
                        loading="lazy"
                      />

                      <span class="poster-play">
                        ▶
                      </span>

                    </div>

                    <h3 class="movie-title">
                      {relatedMovie.title}
                    </h3>

                    <p class="movie-meta">
                      {relatedMovie.year} · {relatedMovie.genre}
                    </p>

                  </a>
                ))}

              </div>

            </section>
          )
        }
      </>
    ) : (
      <section class="section page-section">

        <div class="empty-state">

          <div class="empty-icon">
            ✕
          </div>

          <h1>
            Movie not found.
          </h1>

          <p>
            This movie is not currently available in the vault.
          </p>

          <a
            href="/movies"
            class="btn btn-primary"
          >
            BROWSE MOVIES
          </a>

        </div>

      </section>
    )
  }

  <script is:inline>
    (() => {
      /*
       * -------------------------------------------------------
       * REBELVAULT SMALL PLAYER PROMO
       * -------------------------------------------------------
       */

      const promo =
        document.getElementById('rebelvault-promo');

      const promoClose =
        document.getElementById('rebelvault-promo-close');

      const support =
        document.getElementById('rebelvault-support');

      const supportClose =
        document.getElementById('rebelvault-support-close');

      const player =
        document.getElementById('movie-player');

      if (promo && promoClose && player) {
        let promoTimer = null;

        let firstShown = false;
        let middleShown = false;
        let finalShown = false;

        let manualClosed = false;

        const SHOW_DURATION = 10000;

        function showPromo(stage) {
          if (manualClosed) {
            return;
          }

          if (stage === 'first' && firstShown) {
            return;
          }

          if (stage === 'middle' && middleShown) {
            return;
          }

          if (stage === 'final' && finalShown) {
            return;
          }

          if (stage === 'first') {
            firstShown = true;
          }

          if (stage === 'middle') {
            middleShown = true;
          }

          if (stage === 'final') {
            finalShown = true;
          }

          promo.classList.add('is-visible');
          promo.setAttribute('aria-hidden', 'false');

          if (promoTimer) {
            window.clearTimeout(promoTimer);
          }

          promoTimer = window.setTimeout(() => {
            hidePromo();
          }, SHOW_DURATION);
        }

        function hidePromo() {
          promo.classList.remove('is-visible');
          promo.setAttribute('aria-hidden', 'true');
        }

        promoClose.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();

          manualClosed = true;
          hidePromo();
        });

        const fallbackFirstTimer =
          window.setTimeout(() => {
            showPromo('first');
          }, 10000);

        const fallbackMiddleTimer =
          window.setTimeout(() => {
            showPromo('middle');
          }, 300000);

        const fallbackFinalTimer =
          window.setTimeout(() => {
            showPromo('final');
          }, 600000);

        /*
         * -------------------------------------------------------
         * YOUTUBE IFRAME API
         * -------------------------------------------------------
         */

        let youtubePlayer = null;
        let youtubeReady = false;
        let supportShown = false;

        const SUPPORT_DURATION = 30000;
        const SUPPORT_BEFORE_END = 30;

        let supportTimer = null;

        function showSupportCard() {
          if (
            supportShown ||
            !support
          ) {
            return;
          }

          supportShown = true;

          support.classList.add('is-visible');
          support.setAttribute(
            'aria-hidden',
            'false'
          );

          if (supportTimer) {
            window.clearTimeout(supportTimer);
          }

          supportTimer = window.setTimeout(() => {
            hideSupportCard();
          }, SUPPORT_DURATION);
        }

        function hideSupportCard() {
          if (!support) {
            return;
          }

          support.classList.remove('is-visible');
          support.setAttribute(
            'aria-hidden',
            'true'
          );
        }

        if (supportClose) {
          supportClose.addEventListener(
            'click',
            (event) => {
              event.preventDefault();
              event.stopPropagation();

              hideSupportCard();
            }
          );
        }

        function loadYouTubeAPI() {
          if (window.YT && window.YT.Player) {
            initializeYouTubePlayer();
            return;
          }

          if (
            document.querySelector(
              'script[data-rebelvault-youtube-api]'
            )
          ) {
            return;
          }

          const script =
            document.createElement('script');

          script.src =
            'https://www.youtube.com/iframe_api';

          script.async = true;

          script.dataset.rebelvaultYoutubeApi =
            'true';

          document.head.appendChild(script);

          const previousCallback =
            window.onYouTubeIframeAPIReady;

          window.onYouTubeIframeAPIReady = () => {
            if (typeof previousCallback === 'function') {
              previousCallback();
            }

            initializeYouTubePlayer();
          };
        }

        function getYouTubeVideoId() {
          const iframe =
            player.querySelector('iframe');

          if (!iframe) {
            return null;
          }

          try {
            const url =
              new URL(iframe.src);

            const pathParts =
              url.pathname.split('/');

            const embedIndex =
              pathParts.indexOf('embed');

            if (embedIndex !== -1) {
              return (
                pathParts[embedIndex + 1] || null
              );
            }

            return null;
          } catch {
            return null;
          }
        }

        function initializeYouTubePlayer() {
          if (
            youtubePlayer ||
            !window.YT ||
            !window.YT.Player
          ) {
            return;
          }

          const videoId =
            getYouTubeVideoId();

          if (!videoId) {
            return;
          }

          try {
            youtubePlayer =
              new window.YT.Player(
                player.querySelector('iframe'),
                {
                  events: {
                    onReady: () => {
                      youtubeReady = true;

                      window.setInterval(
                        checkMovieProgress,
                        1000
                      );
                    }
                  }
                }
              );
          } catch {
            /*
             * Fallback timers continue working.
             */
          }
        }

        function checkMovieProgress() {
          if (
            !youtubeReady ||
            !youtubePlayer
          ) {
            return;
          }

          try {
            const duration =
              youtubePlayer.getDuration();

            const currentTime =
              youtubePlayer.getCurrentTime();

            if (
              !duration ||
              currentTime < 0
            ) {
              return;
            }

            const progress =
              currentTime / duration;

            /*
             * First appearance:
             * approximately 10 seconds into the movie.
             */
            if (
              currentTime >= 10 &&
              !firstShown
            ) {
              showPromo('first');
            }

            /*
             * Middle appearance:
             * approximately halfway through.
             */
            if (
              progress >= 0.5 &&
              !middleShown
            ) {
              showPromo('middle');
            }

            /*
             * Final small promo:
             * approximately 90% through.
             */
            if (
              progress >= 0.9 &&
              !finalShown
            ) {
              showPromo('final');
            }

            /*
             * Support card:
             * exactly when approximately 30 seconds
             * remain in the movie.
             */
            const remaining =
              duration - currentTime;

            if (
              remaining <= SUPPORT_BEFORE_END &&
              remaining > 0
            ) {
              showSupportCard();
            }
          } catch {
            /*
             * Ignore player API errors.
             */
          }
        }

        window.setTimeout(() => {
          loadYouTubeAPI();
        }, 1200);

        void fallbackFirstTimer;
        void fallbackMiddleTimer;
        void fallbackFinalTimer;
      }

      const userAgent =
        navigator.userAgent || '';

      /*
       * Telegram-only fullscreen integration.
       * Normal browsers are completely untouched.
       */
      const isTelegramWebView =
        /Telegram/i.test(userAgent) ||
        /TelegramBot/i.test(userAgent);

      if (!isTelegramWebView) {
        return;
      }

      const fullscreenButton =
        document.getElementById('player-fullscreen');

      const closeButton =
        document.getElementById(
          'player-fullscreen-close'
        );

      if (
        !player ||
        !fullscreenButton ||
        !closeButton
      ) {
        return;
      }

      fullscreenButton.hidden = false;

      let telegramWebApp = null;
      let telegramReady = false;

      const telegramSDKPromise =
        loadTelegramSDK();

      telegramSDKPromise.then((webApp) => {
        telegramWebApp = webApp;

        if (!telegramWebApp) {
          return;
        }

        telegramReady = true;

        initializeTelegram(webApp);
      });

      function loadTelegramSDK() {
        return new Promise((resolve) => {
          if (window.Telegram?.WebApp) {
            resolve(window.Telegram.WebApp);
            return;
          }

          const existingScript =
            document.querySelector(
              'script[data-rebelvault-telegram-sdk]'
            );

          if (existingScript) {
            existingScript.addEventListener(
              'load',
              () => {
                resolve(
                  window.Telegram?.WebApp || null
                );
              },
              { once: true }
            );

            existingScript.addEventListener(
              'error',
              () => {
                resolve(null);
              },
              { once: true }
            );

            return;
          }

          const script =
            document.createElement('script');

          script.src =
            'https://telegram.org/js/telegram-web-app.js';

          script.async = true;

          script.dataset.rebelvaultTelegramSdk =
            'true';

          script.onload = () => {
            resolve(
              window.Telegram?.WebApp || null
            );
          };

          script.onerror = () => {
            resolve(null);
          };

          document.head.appendChild(script);
        });
      }

      function initializeTelegram(webApp) {
        try {
          webApp.ready();
        } catch {
          // Ignore initialization errors.
        }

        try {
          webApp.expand();
        } catch {
          // Ignore expand errors.
        }

        try {
          if (webApp.setHeaderColor) {
            webApp.setHeaderColor('#08090c');
          }
        } catch {
          // Ignore unsupported API.
        }

        try {
          if (webApp.setBackgroundColor) {
            webApp.setBackgroundColor('#08090c');
          }
        } catch {
          // Ignore unsupported API.
        }

        try {
          if (webApp.onEvent) {

            webApp.onEvent(
              'fullscreenChanged',
              () => {

                if (webApp.isFullscreen) {

                  document.body.classList.add(
                    'telegram-player-fullscreen'
                  );

                  closeButton.hidden = false;

                  requestLandscape();

                } else {

                  document.body.classList.remove(
                    'telegram-player-fullscreen'
                  );

                  document.body.classList.remove(
                    'player-cinema-mode'
                  );

                  closeButton.hidden = true;

                  restoreOrientation();

                }

              }
            );

            webApp.onEvent(
              'fullscreenFailed',
              () => {

                document.body.classList.add(
                  'player-cinema-mode'
                );

                closeButton.hidden = false;

              }
            );

          }
        } catch {
          // Ignore unsupported Telegram events.
        }
      }

      function requestLandscape() {
        try {
          if (
            screen.orientation &&
            typeof screen.orientation.lock ===
              'function'
          ) {

            const result =
              screen.orientation.lock('landscape');

            if (
              result &&
              typeof result.catch ===
                'function'
            ) {
              result.catch(() => {});
            }

          }
        } catch {
          // Orientation locking is optional.
        }
      }

      function restoreOrientation() {
        try {
          if (
            screen.orientation &&
            typeof screen.orientation.unlock ===
              'function'
          ) {
            screen.orientation.unlock();
          }
        } catch {
          // Ignore unsupported orientation APIs.
        }
      }

      const enterFullscreen = () => {

        document.body.classList.add(
          'player-cinema-mode'
        );

        closeButton.hidden = false;

        requestLandscape();

        if (
          telegramReady &&
          telegramWebApp &&
          typeof telegramWebApp.requestFullscreen ===
            'function'
        ) {

          try {
            telegramWebApp.requestFullscreen();
          } catch {
            // Local player fallback remains active.
          }

          return;
        }

        try {

          if (
            typeof player.requestFullscreen ===
              'function'
          ) {

            const fullscreenRequest =
              player.requestFullscreen();

            if (
              fullscreenRequest &&
              typeof fullscreenRequest.catch ===
                'function'
            ) {
              fullscreenRequest.catch(() => {});
            }

          }

        } catch {
          // Cinema mode remains active.
        }

      };

      const exitFullscreen = async () => {

        try {

          if (
            telegramWebApp &&
            typeof telegramWebApp.exitFullscreen ===
              'function'
          ) {

            telegramWebApp.exitFullscreen();

          }

        } catch {
          // Ignore Telegram exit errors.
        }

        try {

          if (
            document.fullscreenElement &&
            typeof document.exitFullscreen ===
              'function'
          ) {

            await document.exitFullscreen();

          }

        } catch {
          // Ignore browser fullscreen errors.
        }

        restoreOrientation();

        document.body.classList.remove(
          'telegram-player-fullscreen'
        );

        document.body.classList.remove(
          'player-cinema-mode'
        );

        closeButton.hidden = true;
      };

      fullscreenButton.addEventListener(
        'click',
        enterFullscreen
      );

      closeButton.addEventListener(
        'click',
        exitFullscreen
      );

      document.addEventListener(
        'fullscreenchange',
        () => {

          if (document.fullscreenElement) {

            document.body.classList.add(
              'telegram-player-fullscreen'
            );

            closeButton.hidden = false;

            requestLandscape();

          } else if (
            !telegramWebApp?.isFullscreen
          ) {

            document.body.classList.remove(
              'telegram-player-fullscreen'
            );

            document.body.classList.remove(
              'player-cinema-mode'
            );

            closeButton.hidden = true;

            restoreOrientation();

          }

        }
      );

    })();
  </script>

  <style>
    .watch-page {
      position: relative;
      min-height: 620px;
      display: flex;
      align-items: flex-end;
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }

    .watch-backdrop {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          rgba(8, 9, 12, 0.98) 0%,
          rgba(8, 9, 12, 0.86) 42%,
          rgba(8, 9, 12, 0.48) 75%,
          rgba(8, 9, 12, 0.78) 100%
        ),
        linear-gradient(
          0deg,
          #08090c 0%,
          transparent 48%
        );
    }

    .watch-inner {
      position: relative;
      z-index: 2;
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
      padding: 70px 0 90px;
    }

    .watch-layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 650px);
      gap: 48px;
      align-items: end;
      margin-top: 38px;
    }

    .watch-poster {
      width: 260px;
      aspect-ratio: 2 / 3;
      overflow: hidden;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    }

    .watch-poster img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .watch-details h1 {
      margin: 10px 0 18px;
      max-width: 850px;
      color: #fff;
      font-size: clamp(42px, 6vw, 76px);
      line-height: 0.95;
      letter-spacing: -3px;
    }

    .watch-meta {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 24px;
      color: #b4bac3;
      font-size: 13px;
      font-weight: 700;
    }

    .watch-description {
      max-width: 680px;
      margin: 0;
      color: #aeb3bc;
      font-size: 16px;
      line-height: 1.75;
    }

    .watch-cta {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .watch-note {
      color: #737983;
      font-size: 11px;
      line-height: 1.5;
    }

    .back-link {
      color: #9298a2;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: #fff;
    }

    .player-container {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      background: #050506;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    }

    .player-container iframe {
      width: 100%;
      height: 100%;
      flex: 0 0 auto;
      display: block;
      border: 0;
      margin: 0 auto;
    }

    /* -------------------------------------------------------
     * REBELVAULT PLAYER PROMO
     * ------------------------------------------------------- */

    .rebelvault-promo {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 4;

      display: flex;
      align-items: center;
      gap: 12px;

      width: max-content;
      max-width: min(300px, calc(100% - 32px));

      padding: 11px 12px 11px 14px;

      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 10px;

      background:
        linear-gradient(
          135deg,
          rgba(93, 19, 67, 0.96) 0%,
          rgba(45, 24, 88, 0.95) 48%,
          rgba(18, 25, 53, 0.94) 100%
        );

      box-shadow:
        0 12px 35px rgba(0, 0, 0, 0.45),
        0 0 22px rgba(178, 48, 139, 0.18);

      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);

      opacity: 0;
      visibility: hidden;
