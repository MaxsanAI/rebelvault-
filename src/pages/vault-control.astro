---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Vault Control — REBELVAULT"
  description="Private REBELVAULT content management."
>
  <section class="vault-control">
    <div class="vault-control-header">
      <div>
        <div class="eyebrow">
          PRIVATE CONTROL
        </div>

        <h1>
          Vault Control
        </h1>

        <p>
          Add and manage movies inside REBELVAULT.
        </p>
      </div>

      <a
        href="/"
        class="vault-exit"
      >
        EXIT VAULT →
      </a>
    </div>

    <div class="vault-grid">

      <!-- ADD / EDIT MOVIE -->

      <section class="vault-panel">
        <div class="vault-panel-header">
          <div>
            <span class="vault-panel-number">
              01
            </span>

            <h2 id="form-title">
              Add Movie
            </h2>
          </div>

          <span class="vault-status online">
            AUTHENTICATED
          </span>
        </div>

        <form
          id="movie-form"
          class="vault-form"
        >
          <input
            type="hidden"
            id="movie-id"
            name="movie-id"
          />

          <div class="form-group">
            <label for="title">
              Movie Title
            </label>

            <input
              id="title"
              name="title"
              type="text"
              placeholder="Enter movie title"
              autocomplete="off"
              required
            />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="year">
                Year
              </label>

              <input
                id="year"
                name="year"
                type="number"
                min="1888"
                max="2100"
                placeholder="2026"
                required
              />
            </div>

            <div class="form-group">
              <label for="genre">
                Genre
              </label>

              <select
                id="genre"
                name="genre"
                required
              >
                <option value="">
                  Select genre
                </option>

                <option value="Action">
                  Action
                </option>

                <option value="Horror">
                  Horror
                </option>

                <option value="Sci-Fi">
                  Sci-Fi
                </option>

                <option value="Thriller">
                  Thriller
                </option>

                <option value="Comedy">
                  Comedy
                </option>

                <option value="Drama">
                  Drama
                </option>

                <option value="Crime">
                  Crime
                </option>

                <option value="Adventure">
                  Adventure
                </option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="poster">
              Poster URL
            </label>

            <input
              id="poster"
              name="poster"
              type="url"
              placeholder="https://..."
              required
            />

            <small>
              Direct image URL for the movie poster.
            </small>
          </div>

          <div class="form-group">
            <label for="backdrop">
              Backdrop URL
            </label>

            <input
              id="backdrop"
              name="backdrop"
              type="url"
              placeholder="https://..."
              required
            />

            <small>
              Wide cinematic image used for the movie page and featured hero.
            </small>
          </div>

          <div class="form-group">
            <label for="embed">
              YouTube Embed URL
            </label>

            <input
              id="embed"
              name="embed"
              type="url"
              placeholder="https://www.youtube-nocookie.com/embed/..."
              required
            />

            <small>
              Paste the YouTube embed URL, not the normal watch URL.
            </small>
          </div>

          <div class="form-group">
            <label for="description">
              Description
            </label>

            <textarea
              id="description"
              name="description"
              rows="6"
              placeholder="Write a short cinematic description..."
              required
            ></textarea>
          </div>

          <label class="featured-toggle">
            <input
              type="checkbox"
              name="featured"
              id="featured"
            />

            <span class="featured-switch"></span>

            <span>
              <strong>Featured Movie</strong>

              <small>
                Make this the main featured movie on the homepage.
              </small>
            </span>
          </label>

          <div class="form-actions">
            <button
              type="submit"
              class="vault-submit"
              id="submit-button"
            >
              ADD MOVIE TO VAULT
            </button>

            <button
              type="button"
              class="vault-cancel"
              id="cancel-edit"
              hidden
            >
              CANCEL EDIT
            </button>
          </div>

          <div
            id="form-message"
            class="form-message"
            aria-live="polite"
          ></div>
        </form>
      </section>


      <!-- STATUS -->

      <aside class="vault-panel vault-info-panel">
        <div class="vault-panel-header">
          <div>
            <span class="vault-panel-number">
              02
            </span>

            <h2>
              Vault Status
            </h2>
          </div>

          <span
            id="connection-status"
            class="vault-status"
          >
            CHECKING
          </span>
        </div>

        <div class="vault-info-list">
          <div class="vault-info-item">
            <span>
              AUTH
            </span>

            <strong>
              PRIVATE
            </strong>
          </div>

          <div class="vault-info-item">
            <span>
              DATABASE
            </span>

            <strong>
              CLOUDFLARE D1
            </strong>
          </div>

          <div class="vault-info-item">
            <span>
              STORAGE
            </span>

            <strong>
              DATABASE
            </strong>
          </div>

          <div class="vault-info-item">
            <span>
              VIDEO
            </span>

            <strong>
              YOUTUBE
            </strong>
          </div>

          <div class="vault-info-item">
            <span>
              ADS
            </span>

            <strong>
              MONETAG
            </strong>
          </div>

          <div class="vault-info-item">
            <span>
              PUBLIC ROUTE
            </span>

            <strong>
              /movie/[id]
            </strong>
          </div>
        </div>

        <div class="vault-warning">
          <span class="vault-warning-icon">
            ✓
          </span>

          <div>
            <strong>
              Private control panel
            </strong>

            <p>
              This panel and movie management API require the REBELVAULT authentication cookie.
            </p>
          </div>
        </div>

        <div class="vault-preview">
          <div class="vault-preview-label">
            PUBLISH WORKFLOW
          </div>

          <div class="workflow-step">
            <span>01</span>
            Fill movie details
          </div>

          <div class="workflow-line"></div>

          <div class="workflow-step">
            <span>02</span>
            Submit movie
          </div>

          <div class="workflow-line"></div>

          <div class="workflow-step">
            <span>03</span>
            Save to D1
          </div>

          <div class="workflow-line"></div>

          <div class="workflow-step">
            <span>04</span>
            Movie published
          </div>
        </div>

        <div
          id="movie-result"
          class="movie-result"
        ></div>
      </aside>
    </div>


    <!-- MOVIE LIBRARY -->

    <section class="vault-panel library-panel">
      <div class="vault-panel-header">
        <div>
          <span class="vault-panel-number">
            03
          </span>

          <h2>
            Movie Library
          </h2>
        </div>

        <span
          id="library-count"
          class="vault-status"
        >
          LOADING
        </span>
      </div>

      <div
        id="movie-library"
        class="movie-library"
      >
        <div class="library-empty">
          Loading vault content...
        </div>
      </div>
    </section>
  </section>


  <script>
    type Movie = {
      id: string;
      title: string;
      year: number;
      genre: string;
      poster: string;
      backdrop: string;
      description: string;
      embed: string;
      featured: number | boolean;
      created_at?: string;
    };

    const form =
      document.querySelector<HTMLFormElement>('#movie-form');

    const message =
      document.querySelector<HTMLDivElement>('#form-message');

    const submitButton =
      document.querySelector<HTMLButtonElement>('#submit-button');

    const cancelEditButton =
      document.querySelector<HTMLButtonElement>('#cancel-edit');

    const connectionStatus =
      document.querySelector<HTMLSpanElement>('#connection-status');

    const movieResult =
      document.querySelector<HTMLDivElement>('#movie-result');

    const movieLibrary =
      document.querySelector<HTMLDivElement>('#movie-library');

    const libraryCount =
      document.querySelector<HTMLSpanElement>('#library-count');

    const formTitle =
      document.querySelector<HTMLHeadingElement>('#form-title');

    const movieIdInput =
      document.querySelector<HTMLInputElement>('#movie-id');

    const titleInput =
      document.querySelector<HTMLInputElement>('#title');

    const yearInput =
      document.querySelector<HTMLInputElement>('#year');

    const genreInput =
      document.querySelector<HTMLSelectElement>('#genre');

    const posterInput =
      document.querySelector<HTMLInputElement>('#poster');

    const backdropInput =
      document.querySelector<HTMLInputElement>('#backdrop');

    const embedInput =
      document.querySelector<HTMLInputElement>('#embed');

    const descriptionInput =
      document.querySelector<HTMLTextAreaElement>('#description');

    const featuredInput =
      document.querySelector<HTMLInputElement>('#featured');

    let movies: Movie[] = [];
    let editingMovieId = '';

    function isFeatured(movie: Movie) {
      return movie.featured === true || movie.featured === 1;
    }

    function escapeHtml(value: string) {
      return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function resetForm() {
      form?.reset();

      if (movieIdInput) {
        movieIdInput.value = '';
      }

      editingMovieId = '';

      if (formTitle) {
        formTitle.textContent = 'Add Movie';
      }

      if (submitButton) {
        submitButton.textContent = 'ADD MOVIE TO VAULT';
      }

      if (cancelEditButton) {
        cancelEditButton.hidden = true;
      }

      if (message) {
        message.className = 'form-message';
        message.textContent = '';
      }
    }

    function showFormMessage(
      type: 'success' | 'error',
      text: string
    ) {
      if (!message) return;

      message.className = `form-message ${type}`;
      message.textContent = text;
    }

    function startEdit(movie: Movie) {
      editingMovieId = movie.id;

      if (movieIdInput) {
        movieIdInput.value = movie.id;
      }

      if (titleInput) {
        titleInput.value = movie.title;
      }

      if (yearInput) {
        yearInput.value = String(movie.year);
      }

      if (genreInput) {
        genreInput.value = movie.genre;
      }

      if (posterInput) {
        posterInput.value = movie.poster;
      }

      if (backdropInput) {
        backdropInput.value = movie.backdrop;
      }

      if (embedInput) {
        embedInput.value = movie.embed;
      }

      if (descriptionInput) {
        descriptionInput.value = movie.description;
      }

      if (featuredInput) {
        featuredInput.checked = isFeatured(movie);
      }

      if (formTitle) {
        formTitle.textContent = 'Edit Movie';
      }

      if (submitButton) {
        submitButton.textContent = 'SAVE MOVIE CHANGES';
      }

      if (cancelEditButton) {
        cancelEditButton.hidden = false;
      }

      if (message) {
        message.className = 'form-message';
        message.textContent = '';
      }

      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    }

    async function loadMovies() {
      if (!movieLibrary) return;

      try {
        const response = await fetch(
          '/api/admin/movie',
          {
            method: 'GET',
            headers: {
              Accept: 'application/json',
            },
            credentials: 'same-origin',
            cache: 'no-store',
          }
        );

        let data: any = null;

        try {
          data = await response.json();
        } catch {
          data = null;
        }

        if (response.status === 401) {
          window.location.href =
            '/vault-control/login';
          return;
        }

        if (!response.ok || !data?.success) {
          throw new Error(
            data?.error ||
            'Unable to load movie library.'
          );
        }

        movies = Array.isArray(data.movies)
          ? data.movies
          : [];

        if (libraryCount) {
          libraryCount.textContent =
            `${movies.length} ${movies.length === 1 ? 'MOVIE' : 'MOVIES'}`;

          libraryCount.classList.remove('error');
          libraryCount.classList.add('online');
        }

        renderMovieLibrary();
      } catch (error) {
        if (libraryCount) {
          libraryCount.textContent = 'ERROR';
          libraryCount.classList.remove('online');
          libraryCount.classList.add('error');
        }

        movieLibrary.innerHTML = `
          <div class="library-empty error">
            ${escapeHtml(
              error instanceof Error
                ? error.message
                : 'Unable to load movie library.'
            )}
          </div>
        `;
      }
    }

    function renderMovieLibrary() {
      if (!movieLibrary) return;

      if (!movies.length) {
        movieLibrary.innerHTML = `
          <div class="library-empty">
            No movies have been published yet.
          </div>
        `;
        return;
      }

      movieLibrary.innerHTML = '';

      for (const movie of movies) {
        const card =
          document.createElement('article');

        card.className = 'movie-card';

        const poster =
          document.createElement('img');

        poster.className = 'movie-card-poster';
        poster.src = movie.poster;
        poster.alt = movie.title;
        poster.loading = 'lazy';

        poster.onerror = () => {
          poster.style.opacity = '0.2';
        };

        const content =
          document.createElement('div');

        content.className = 'movie-card-content';

        const top =
          document.createElement('div');

        top.className = 'movie-card-top';

        const title =
          document.createElement('h3');

        title.textContent = movie.title;

        const meta =
          document.createElement('div');

        meta.className = 'movie-card-meta';

        const metaText =
          document.createElement('span');

        metaText.textContent =
          `${movie.year} · ${movie.genre}`;

        meta.appendChild(metaText);

        if (isFeatured(movie)) {
          const featured =
            document.createElement('span');

          featured.className = 'movie-featured-badge';
          featured.textContent = 'FEATURED';

          meta.appendChild(featured);
        }

        top.appendChild(title);
        top.appendChild(meta);

        const id =
          document.createElement('div');

        id.className = 'movie-card-id';
        id.textContent = `/movie/${movie.id}`;

        const actions =
          document.createElement('div');

        actions.className = 'movie-card-actions';

        const editButton =
          document.createElement('button');

        editButton.type = 'button';
        editButton.className = 'movie-edit-button';
        editButton.textContent = 'EDIT';

        editButton.addEventListener(
          'click',
          () => startEdit(movie)
        );

        const deleteButton =
          document.createElement('button');

        deleteButton.type = 'button';
        deleteButton.className = 'movie-delete-button';
        deleteButton.textContent = 'DELETE';

        deleteButton.addEventListener(
          'click',
          () => deleteMovie(movie, deleteButton)
        );

        actions.appendChild(editButton);
        actions.appendChild(deleteButton);

        content.appendChild(top);
        content.appendChild(id);
        content.appendChild(actions);

        card.appendChild(poster);
        card.appendChild(content);

        movieLibrary.appendChild(card);
      }
    }

    async function deleteMovie(
      movie: Movie,
      button: HTMLButtonElement
    ) {
      const confirmed =
        window.confirm(
          `Delete "${movie.title}" from REBELVAULT? This cannot be undone.`
        );

      if (!confirmed) {
        return;
      }

      button.disabled = true;
      button.textContent = 'DELETING...';

      try {
        const response = await fetch(
          '/api/admin/movie',
          {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            credentials: 'same-origin',
            body: JSON.stringify({
              id: movie.id,
            }),
          }
        );

        let data: any = null;

        try {
          data = await response.json();
        } catch {
          data = null;
        }

        if (response.status === 401) {
          window.location.href =
            '/vault-control/login';
          return;
        }

        if (!response.ok || !data?.success) {
          throw new Error(
            data?.error ||
            'Unable to delete movie.'
          );
        }

        if (editingMovieId === movie.id) {
          resetForm();
        }

        showFormMessage(
          'success',
          `“${movie.title}” has been deleted from the vault.`
        );

        await loadMovies();
        await checkConnection();
      } catch (error) {
        showFormMessage(
          'error',
          error instanceof Error
            ? error.message
            : 'Unable to delete movie.'
        );

        button.disabled = false;
        button.textContent = 'DELETE';
      }
    }

    async function checkConnection() {
      if (!connectionStatus) return;

      connectionStatus.classList.remove(
        'online',
        'error'
      );

      connectionStatus.textContent = 'CHECKING';

      try {
        const response = await fetch(
          '/api/movies',
          {
            method: 'GET',
            headers: {
              Accept: 'application/json',
            },
            cache: 'no-store',
          }
        );

        const data = await response.json();

        if (response.ok && data.success) {
          connectionStatus.textContent = 'ONLINE';
          connectionStatus.classList.add('online');

          if (
            movieResult &&
            typeof data.count === 'number'
          ) {
            movieResult.innerHTML = `
              <span>VAULT CONTENT</span>
              <strong>${data.count}</strong>
              <small>
                ${data.count === 1 ? 'movie stored' : 'movies stored'}
              </small>
            `;
          }

          return;
        }

        connectionStatus.textContent = 'ERROR';
        connectionStatus.classList.add('error');
      } catch {
        connectionStatus.textContent = 'OFFLINE';
        connectionStatus.classList.add('error');
      }
    }

    cancelEditButton?.addEventListener(
      'click',
      () => {
        resetForm();
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      }
    );

    form?.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault();

        if (
          !form ||
          !message ||
          !submitButton
        ) {
          return;
        }

        const formData =
          new FormData(form);

        const payload = {
          id: String(
            formData.get('movie-id') ?? ''
          ).trim(),

          title: String(
            formData.get('title') ?? ''
          ).trim(),

          year: Number(
            formData.get('year')
          ),

          genre: String(
            formData.get('genre') ?? ''
          ).trim(),

          poster: String(
            formData.get('poster') ?? ''
          ).trim(),

          backdrop: String(
            formData.get('backdrop') ?? ''
          ).trim(),

          embed: String(
            formData.get('embed') ?? ''
          ).trim(),

          description: String(
            formData.get('description') ?? ''
          ).trim(),

          featured:
            formData.get('featured') === 'on',
        };

        const isEditing =
          Boolean(editingMovieId);

        submitButton.disabled = true;

        submitButton.textContent =
          isEditing
            ? 'SAVING CHANGES...'
            : 'ADDING TO VAULT...';

        message.className =
          'form-message';

        message.textContent = '';

        try {
          const response =
            await fetch(
              '/api/admin/movie',
              {
                method:
                  isEditing
                    ? 'PUT'
                    : 'POST',

                headers: {
                  'Content-Type':
                    'application/json',

                  Accept:
                    'application/json',
                },

                credentials:
                  'same-origin',

                body:
                  JSON.stringify(
                    payload
                  ),
              }
            );

          let data: any = null;

          try {
            data =
              await response.json();
          } catch {
            data = null;
          }

          if (
            response.status === 401
          ) {
            window.location.href =
              '/vault-control/login';

            return;
          }

          if (
            !response.ok ||
            !data?.success
          ) {
            throw new Error(
              data?.error ||
              (
                isEditing
                  ? 'Unable to update movie.'
                  : 'Unable to add movie.'
              )
            );
          }

          showFormMessage(
            'success',
            isEditing
              ? `“${data.movie.title}” has been updated.`
              : `“${data.movie.title}” has been added to the vault.`
          );

          if (movieResult) {
            movieResult.innerHTML = `
              <span>${isEditing ? 'LAST UPDATED' : 'LAST PUBLISHED'}</span>
              <strong>${escapeHtml(data.movie.title)}</strong>
              <small>/movie/${escapeHtml(data.movie.id)}</small>
            `;
          }

          resetForm();

          await loadMovies();
          await checkConnection();
        } catch (error) {
          showFormMessage(
            'error',
            error instanceof Error
              ? error.message
              : (
                  isEditing
                    ? 'Unable to update movie.'
                    : 'Unable to add movie.'
                )
          );
        } finally {
          submitButton.disabled = false;

          submitButton.textContent =
            editingMovieId
              ? 'SAVE MOVIE CHANGES'
              : 'ADD MOVIE TO VAULT';
        }
      }
    );

    checkConnection();
    loadMovies();
  </script>


  <style>
    .vault-control {
      width: min(1400px, calc(100% - 40px));
      margin: 0 auto;
      padding: 90px 0 120px;
    }

    .vault-control-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 50px;
    }

    .vault-control-header h1 {
      margin: 8px 0 0;
      font-size: clamp(48px, 7vw, 92px);
      line-height: .9;
      letter-spacing: -5px;
    }

    .vault-control-header p {
      margin: 20px 0 0;
      color: #858a94;
      font-size: 16px;
    }

    .vault-exit {
      color: #ff4938;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.5px;
      white-space: nowrap;
    }

    .vault-grid {
      display: grid;
      grid-template-columns:
        minmax(0, 1.7fr)
        minmax(320px, .8fr);
      gap: 24px;
    }

    .vault-panel {
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 16px;
      background:
        radial-gradient(
          circle at 90% 0%,
          rgba(255,73,56,.07),
          transparent 32%
        ),
        #0d0f13;
      padding: 32px;
    }

    .library-panel {
      margin-top: 24px;
    }

    .vault-panel-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      padding-bottom: 26px;
      margin-bottom: 28px;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .vault-panel-number {
      display: block;
      margin-bottom: 8px;
      color: #ff4938;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    .vault-panel h2 {
      margin: 0;
      font-size: 26px;
      letter-spacing: -1px;
    }

    .vault-status {
      padding: 7px 10px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 5px;
      color: #9ca1aa;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 1.5px;
    }

    .vault-status.online {
      border-color: rgba(75,210,135,.2);
      color: #71dca0;
    }

    .vault-status.error {
      border-color: rgba(255,73,56,.2);
      color: #ff7668;
    }

    .vault-form {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .form-group {
      display: flex;
